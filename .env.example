# ══════════════════════════════════════════
# Job Matcher 环境变量示例
# 复制为 .env 后填入自己的值；.env 已被 git 忽略
# ══════════════════════════════════════════

# ── 访问口令（公网部署必须设置）──
# 生成方式：openssl rand -hex 16
JOB_MATCHER_TOKEN=

# ── 服务监听 ──
JOB_MATCHER_PORT=7788
JOB_MATCHER_HOST=127.0.0.1

# ── AI 供应商（可选；不配则 AI 功能关闭，其它功能照常）──
# 可选值：openrouter / nvidia / deepseek / openai / qwen / moonshot / ollama
JOB_MATCHER_PROVIDER=

# 方式一：OpenRouter 免费模型
# OPENROUTER_API_KEY=sk-or-v1-xxxx
# JOB_MATCHER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 方式二：NVIDIA NIM
# NVIDIA_API_KEY=nvapi-xxxx
# JOB_MATCHER_MODEL=meta/llama-3.3-70b-instruct

# 方式三：本地 Ollama（无需 Key）
# JOB_MATCHER_PROVIDER=ollama
# JOB_MATCHER_MODEL=qwen2.5:7b

# ── 配额与限流 ──
JOB_MATCHER_AI_DAILY_LIMIT=200
JOB_MATCHER_RATE_LIMIT=120
JOB_MATCHER_TIMEOUT_MS=60000
