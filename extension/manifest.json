{
  "manifest_version": 3,
  "name": "AI 求职助手 · 岗位匹配",
  "version": "1.0.0",
  "description": "在招聘网站看岗位时，一键按你的简历算匹配度，并给出改简历和备面试建议。",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "https://*.zhipin.com/*",
    "https://*.zhaopin.com/*",
    "https://*.liepin.com/*",
    "https://*.lagou.com/*",
    "https://*.51job.com/*",
    "https://*.linkedin.com/*",
    "https://*.nowcoder.com/*",
    "https://*.bosszhipin.com/*",
    "http://150.158.49.37/*",
    "https://150.158.49.37/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhipin.com/*",
        "https://*.zhipin.com/*",
        "https://*.zhaopin.com/*",
        "https://*.liepin.com/*",
        "https://*.lagou.com/*",
        "https://*.51job.com/*",
        "https://*.linkedin.com/*",
        "https://*.nowcoder.com/*",
        "https://*.bosszhipin.com/*"
      ],
      "js": [
        "extractor.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI 求职助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
